{
	"schemaVersion": 1,
	"id": "sharedwaypoints",
	"version": "${version}",
	"name": "Shared Waypoints",
	"description": "A Minecraft Fabric mod to permanently share a whole list of Waypoints created through Xaero's MiniMap mod",
	"authors": [
		"Hugo-D"
	],
	"contact": {
		"homepage": "/",
		"sources": "https://github.com/Hugo-D/minecraft-shared-waypoints"
	},
	"license": "CC0-1.0",
	"icon": "assets/sharedwaypoints/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.ibuildstuff.hugo_d.minecraftsharedwaypoints.SharedWaypointsMod"
		],
		"client": [
          "com.ibuildstuff.hugo_d.minecraftsharedwaypoints.client.SharedWaypointsModClient"
		]
	},
	"mixins": [
      "sharedwaypoints.mixins.json",
		{
			"config": "sharedwaypoints.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "xaerominimap-fabric-1.21.1-25.3.7"
	}
}